<Window x:Class="MeetingAgent.App.ProtectedPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MeetingAgent.App.ViewModels"
        Title="MeetingGuard · 保护预览"
        Width="640" Height="480"
        MinWidth="320" MinHeight="240"
        Background="#000000"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

  <Window.Resources>
    <vm:NullToVisibilityConverter    x:Key="NullToVis"/>
    <vm:NotNullToVisibilityConverter x:Key="NotNullToVis"/>

    <Style x:Key="OverlayBtn" TargetType="Button">
      <Setter Property="Background"     Value="#44FFFFFF"/>
      <Setter Property="Foreground"     Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize"       Value="11.5"/>
      <Setter Property="Cursor"         Value="Hand"/>
      <Setter Property="Padding"        Value="10,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#66FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- 保护后的帧（绑定 FaceProtectViewModel.ProtectedFrameImage） -->
    <Image x:Name="ProtectedImage"
           Source="{Binding ProtectedFrameImage}"
           Stretch="Uniform"
           RenderOptions.BitmapScalingMode="HighQuality"/>

    <!-- 无画面时的占位提示 -->
    <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding ProtectedFrameImage, Converter={StaticResource NullToVis}}">
      <TextBlock Text="&#x1F6E1;" FontSize="40" HorizontalAlignment="Center" Foreground="#3FB950"/>
      <TextBlock Text="等待保护帧..." Foreground="#8B949E" FontSize="14" Margin="0,10,0,0"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="请先在主窗口开启实时人脸保护" Foreground="#8B949E" FontSize="12" Margin="0,6,0,0"
                 HorizontalAlignment="Center"/>
    </StackPanel>

    <!-- 悬浮工具栏（代码后端控制淡入淡出） -->
    <Border x:Name="Toolbar" VerticalAlignment="Top" HorizontalAlignment="Stretch"
            Background="#CC000000" Padding="8,6" Opacity="0">
      <DockPanel>
        <TextBlock Text="&#x1F6E1; MeetingGuard &#xB7; 保护预览" Foreground="White" FontSize="12.5"
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="PinBtn"  Style="{StaticResource OverlayBtn}" Content="&#x1F4CC; 置顶"
                  Click="PinBtn_Click"  Margin="0,0,6,0"/>
          <Button x:Name="HintBtn" Style="{StaticResource OverlayBtn}" Content="OBS 提示"
                  Click="HintBtn_Click" Margin="0,0,6,0"/>
          <Button Style="{StaticResource OverlayBtn}" Content="&#x2715; 关闭"
                  Click="CloseBtn_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 左下角状态条 -->
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
            Margin="8" Padding="7,3" Background="#CC000000" CornerRadius="4">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                 VerticalAlignment="Center" Margin="0,0,6,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="#8B949E"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsProtecting}" Value="True">
                  <Setter Property="Fill" Value="#3FB950"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock x:Name="StatusText" Foreground="#8B949E" FontSize="11.5">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="未保护"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsProtecting}" Value="True">
                  <Setter Property="Text" Value="保护中"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock x:Name="LatencyText" Text="{Binding OnlineLatencyText}"
                   Foreground="#8B949E" FontSize="11.5" Margin="10,0,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
