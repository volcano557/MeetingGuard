{
  "Gateway": {
    "Host": "127.0.0.1",
    "Port": 8000,
    "Url": "http://127.0.0.1:8000"
  },
  "FaceProtect": {
    "Host": "127.0.0.1",
    "Port": 5001,
    "Url": "http://127.0.0.1:5001"
  },
  "SemanticRisk": {
    "Host": "127.0.0.1",
    "Port": 8003,
    "Url": "http://127.0.0.1:8003"
  },
  "LinuxBackend": {
    "Protocol": "http",
    "Host": "127.0.0.1",
    "Port": 50053,
    "GatewayUrl": "http://127.0.0.1:50053",
    "UseGateway": false,
    "AuthToken": "",
    "UseLosslessCompression": false,
    "Compression": "none",
    "ReconnectDelaySeconds": 3,
    "HeartbeatIntervalSeconds": 10,
    "RequestTimeoutSeconds": 15,
    "Http": {
      "Scheme": "http",
      "HealthPingMethod": "GET",
      "SessionStartPath": "/api/agent/session/start",
      "SessionStopPath": "/api/agent/session/stop",
      "VideoFramePath": "/api/agent/video/frame",
      "AudioChunkPath": "/api/agent/audio/chunk",
      "HealthPingPath": "/health",
      "DetectionPollPath": "/api/agent/results/poll",
      "EnableDetectionPolling": false,
      "PollingIntervalMs": 1000
    }
  },
  "Capture": {
    "TargetFps": 5,
    "EnableResize": true,
    "ResizeWidth": 480,
    "ResizeHeight": 480,
    "PixelFormat": "BGRA8"
  },
  "Audio": {
    "Enabled": true,
    "CaptureMode": "loopback",
    "LoopbackRole": "Multimedia",
    "SampleRate": 16000,
    "Channels": 1,
    "BitsPerSample": 16,
    "ChunkMilliseconds": 100
  },
  "Alerting": {
    "CooldownSeconds": 8,
    "EnableToast": true,
    "EnableSound": false,
    "MaxHistory": 100
  },
  "Logging": {
    "LogDirectory": "logs"
  }
}
