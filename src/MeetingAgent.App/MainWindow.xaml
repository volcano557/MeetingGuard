<Window x:Class="MeetingAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MeetingAgent.App.ViewModels"
        Title="MeetingGuard — 智能会议安全防护平台"
        Width="1400" Height="860" MinWidth="1100" MinHeight="700"
        Background="#0D1117" WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- ── 颜色常量 ───────────────────────────────────────── -->
    <SolidColorBrush x:Key="BgMain"      Color="#0D1117"/>
    <SolidColorBrush x:Key="BgSidebar"   Color="#010409"/>
    <SolidColorBrush x:Key="BgCard"      Color="#161B22"/>
    <SolidColorBrush x:Key="BgSubCard"   Color="#21262D"/>
    <SolidColorBrush x:Key="BgInput"     Color="#21262D"/>
    <SolidColorBrush x:Key="BorderColor" Color="#30363D"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="TextMuted"   Color="#8B949E"/>
    <SolidColorBrush x:Key="AccentBlue"  Color="#58A6FF"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#3FB950"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#F6C95F"/>
    <SolidColorBrush x:Key="AccentRed"    Color="#F85149"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#A98BFF"/>

    <!-- ── 卡片 ─────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background"       Value="#161B22"/>
      <Setter Property="BorderBrush"      Value="#30363D"/>
      <Setter Property="BorderThickness"  Value="1"/>
      <Setter Property="CornerRadius"     Value="8"/>
      <Setter Property="Padding"          Value="20"/>
      <Setter Property="Margin"           Value="0,0,0,14"/>
    </Style>
    <Style x:Key="SubCard" TargetType="Border">
      <Setter Property="Background"      Value="#21262D"/>
      <Setter Property="CornerRadius"    Value="6"/>
      <Setter Property="Padding"         Value="14,10"/>
      <Setter Property="BorderBrush"     Value="#30363D"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ── 按钮基础模板 ─────────────────────────────────── -->
    <ControlTemplate x:Key="BtnTpl" TargetType="Button">
      <Border x:Name="bd" Background="{TemplateBinding Background}"
              CornerRadius="6" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background"  Value="#238636"/>
      <Setter Property="Foreground"  Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"     Value="16,8"/>
      <Setter Property="FontSize"    Value="13"/>
      <Setter Property="FontWeight"  Value="SemiBold"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="Template"    Value="{StaticResource BtnTpl}"/>
    </Style>
    <Style x:Key="BtnSec" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#21262D"/>
    </Style>
    <Style x:Key="BtnBlue" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#1F6FEB"/>
    </Style>
    <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#B62324"/>
    </Style>
    <Style x:Key="BtnOrange" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#9E6A03"/>
    </Style>

    <!-- ── 输入框 ─────────────────────────────────────────── -->
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Background"     Value="#21262D"/>
      <Setter Property="Foreground"     Value="#E6EDF3"/>
      <Setter Property="CaretBrush"     Value="#58A6FF"/>
      <Setter Property="BorderBrush"    Value="#30363D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"        Value="10,7"/>
      <Setter Property="FontSize"       Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PwdInput" TargetType="PasswordBox">
      <Setter Property="Background"     Value="#21262D"/>
      <Setter Property="Foreground"     Value="#E6EDF3"/>
      <Setter Property="CaretBrush"     Value="#58A6FF"/>
      <Setter Property="BorderBrush"    Value="#30363D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"        Value="10,7"/>
      <Setter Property="FontSize"       Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 继承 App.xaml 中的全局暗色 ComboBox 模板（含弹出层暗色）-->
    <Style x:Key="ComboInput" TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Padding"  Value="10,6"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ── DataGrid ───────────────────────────────────────── -->
    <Style TargetType="DataGrid">
      <Setter Property="Background"          Value="Transparent"/>
      <Setter Property="Foreground"          Value="#E6EDF3"/>
      <Setter Property="BorderBrush"         Value="#30363D"/>
      <Setter Property="BorderThickness"     Value="1"/>
      <Setter Property="RowBackground"       Value="Transparent"/>
      <Setter Property="AlternatingRowBackground" Value="#0D111788"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#21262D"/>
      <Setter Property="HeadersVisibility"   Value="Column"/>
      <Setter Property="CanUserAddRows"      Value="False"/>
      <Setter Property="CanUserDeleteRows"   Value="False"/>
      <Setter Property="IsReadOnly"          Value="True"/>
      <Setter Property="SelectionUnit"       Value="FullRow"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="FontSize"            Value="12.5"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background"   Value="#21262D"/>
      <Setter Property="Foreground"   Value="#8B949E"/>
      <Setter Property="Padding"      Value="12,8"/>
      <Setter Property="FontSize"     Value="12"/>
      <Setter Property="FontWeight"   Value="SemiBold"/>
      <Setter Property="BorderBrush"  Value="#30363D"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding"           Value="12,7"/>
      <Setter Property="BorderThickness"   Value="0"/>
      <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#30363D55"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#58A6FF22"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ── 侧栏导航按钮 ─────────────────────────────────── -->
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="#8B949E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"         Value="16,11"/>
      <Setter Property="FontSize"        Value="13.5"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="6" Margin="6,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#21262D"/>
                <Setter Property="Foreground" Value="#E6EDF3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 滚动条极简样式 ──────────────────────────────── -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid>
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#30363D" CornerRadius="3" Margin="1"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" Opacity="0"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 标签页（无头隐藏） ─────────────────────────── -->
    <Style TargetType="TabControl">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <ContentPresenter x:Name="cp" ContentSource="Content"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 转换器 ──────────────────────────────────────── -->
    <vm:NullToVisibilityConverter    x:Key="NullToVis"/>
    <vm:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
    <vm:ZeroToVisibilityConverter    x:Key="ZeroToVis"/>
    <vm:BoolNegConverter             x:Key="BoolNeg"/>
    <vm:ColorStringToBrushConverter  x:Key="ColorBrush"/>
    <BooleanToVisibilityConverter    x:Key="BoolToVis"/>
    <vm:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis"/>

    <!-- ── ProgressBar ──────────────────────────────────── -->
    <Style x:Key="PBar" TargetType="ProgressBar">
      <Setter Property="Height"     Value="6"/>
      <Setter Property="Background" Value="#30363D"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#58A6FF" Offset="0"/>
                    <GradientStop Color="#3FB950" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PBarGreen" TargetType="ProgressBar" BasedOn="{StaticResource PBar}">
      <Setter Property="Foreground" Value="#3FB950"/>
    </Style>
    <Style x:Key="PBarOrange" TargetType="ProgressBar" BasedOn="{StaticResource PBar}">
      <Setter Property="Foreground" Value="#F6C95F"/>
    </Style>
  </Window.Resources>

  <!-- ════════════════════════════════════════════════════════
       整体布局：左侧边栏 + 右内容区
       ════════════════════════════════════════════════════════ -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ══════════════════════════════════════════════════════
         左侧边栏
         ══════════════════════════════════════════════════════ -->
    <Border Grid.Column="0" Background="#010409"
            BorderBrush="#21262D" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- 应用标题 -->
        <Border DockPanel.Dock="Top" Padding="16,20,16,14"
                BorderBrush="#21262D" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="MeetingGuard" Foreground="#E6EDF3" FontSize="17"
                       FontWeight="Bold"/>
            <TextBlock Text="智能会议安全防护" Foreground="#8B949E" FontSize="11.5" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>

        <!-- 底部系统状态 -->
        <Border DockPanel.Dock="Bottom" Padding="14,12"
                BorderBrush="#21262D" BorderThickness="0,1,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Ellipse Width="7" Height="7" Fill="#3FB950" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="系统运行中" Foreground="#8B949E" FontSize="11.5"/>
            </StackPanel>
            <TextBlock Text="{Binding SysUptimeText}" Foreground="#444D56" FontSize="11"/>
          </StackPanel>
        </Border>

        <!-- 导航菜单 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="主功能" Foreground="#444D56" FontSize="11" FontWeight="SemiBold"
                       Margin="22,4,0,6"/>

            <!-- 工作台 -->
            <Button Command="{Binding NavCommand}" CommandParameter="0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                      <Setter Property="Background" Value="#161B22"/>
                      <Setter Property="Foreground" Value="#58A6FF"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="▦" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="工作台" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <!-- 身份认证 -->
            <Button Command="{Binding NavCommand}" CommandParameter="1">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                      <Setter Property="Background" Value="#161B22"/>
                      <Setter Property="Foreground" Value="#58A6FF"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔐" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="身份认证" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <TextBlock Text="安全检测" Foreground="#444D56" FontSize="11" FontWeight="SemiBold"
                       Margin="22,10,0,6"/>

            <!-- 视频采样 -->
            <Button Command="{Binding NavCommand}" CommandParameter="2">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                      <Setter Property="Background" Value="#161B22"/>
                      <Setter Property="Foreground" Value="#58A6FF"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="📹" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="视频会议采样" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <!-- 面部保护 -->
            <Button Command="{Binding NavCommand}" CommandParameter="3">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                      <Setter Property="Background" Value="#161B22"/>
                      <Setter Property="Foreground" Value="#58A6FF"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛡" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="面部隐私保护" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <!-- AIGC 检测 -->
            <Button Command="{Binding NavCommand}" CommandParameter="4">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                      <Setter Property="Background" Value="#161B22"/>
                      <Setter Property="Foreground" Value="#58A6FF"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="AIGC 视频检测" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <!-- 语义风险 -->
            <Button Command="{Binding NavCommand}" CommandParameter="5">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                      <Setter Property="Background" Value="#161B22"/>
                      <Setter Property="Foreground" Value="#58A6FF"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎙" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="语义风险识别" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <TextBlock Text="管理分析" Foreground="#444D56" FontSize="11" FontWeight="SemiBold"
                       Margin="22,10,0,6"/>

            <!-- 数据统计 -->
            <Button Command="{Binding NavCommand}" CommandParameter="6">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="6">
                      <Setter Property="Background" Value="#161B22"/>
                      <Setter Property="Foreground" Value="#58A6FF"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="数据统计分析" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ══════════════════════════════════════════════════════
         右侧内容区（TabControl）
         ══════════════════════════════════════════════════════ -->
    <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}">

      <!-- ════════════════════════════════════════════════════
           Tab 0: 工作台
           ════════════════════════════════════════════════════ -->
      <TabItem>
        <ScrollViewer Background="#0D1117" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24,28,24" MaxWidth="1000">
            <!-- 页头 -->
            <DockPanel Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="工作台" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="会议安全监测中心，查看实时状态并创建新会议" Foreground="#8B949E" FontSize="13" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="6" Padding="12,6" Background="#F8514926" BorderBrush="#F8514966" BorderThickness="1" Margin="0,0,10,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" Foreground="#F85149" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding DashboardRiskCountText, StringFormat='{}未处置风险：{0} 条'}" Foreground="#F85149" FontSize="12.5"/>
                  </StackPanel>
                </Border>
                <Border CornerRadius="6" Padding="12,6" Background="#3FB95026" BorderBrush="#3FB95066" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="#3FB950" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding DashboardServiceText, StringFormat='{}服务在线：{0}'}" Foreground="#3FB950" FontSize="12.5"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DockPanel>

            <!-- KPI 四格 -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="86" Foreground="#58A6FF" FontSize="32" FontWeight="Bold"/>
                  <TextBlock Text="历史会议场次" Foreground="#8B949E" FontSize="12.5" Margin="0,4,0,0"/>
                  <TextBlock Text="↑ 3 本周" Foreground="#3FB950" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="142" Foreground="#F6C95F" FontSize="32" FontWeight="Bold"/>
                  <TextBlock Text="累计风险事件" Foreground="#8B949E" FontSize="12.5" Margin="0,4,0,0"/>
                  <TextBlock Text="↑ 8 本周" Foreground="#F6C95F" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="0.34" Foreground="#A98BFF" FontSize="32" FontWeight="Bold"/>
                  <TextBlock Text="平均风险评分" Foreground="#8B949E" FontSize="12.5" Margin="0,4,0,0"/>
                  <TextBlock Text="↓ 0.02 趋势向好" Foreground="#3FB950" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                <StackPanel>
                  <TextBlock Text="94.4%" Foreground="#3FB950" FontSize="32" FontWeight="Bold"/>
                  <TextBlock Text="事件处置率" Foreground="#8B949E" FontSize="12.5" Margin="0,4,0,0"/>
                  <TextBlock Text="— 良好" Foreground="#3FB950" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- 创建会议 + 快速入口 -->
            <Grid Margin="0,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="320"/>
              </Grid.ColumnDefinitions>
              <!-- 创建会议 -->
              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="创建安全监测会议" Foreground="#E6EDF3" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="会议名称" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
                      <TextBox Style="{StaticResource Input}" Text="{Binding MeetingName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="会议 ID" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
                      <TextBox Style="{StaticResource Input}" Text="{Binding MeetingId, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Style="{StaticResource Btn}" Content="▶ 创建并进入检测" Command="{Binding EnterMeetingCommand}" Padding="22,10" FontSize="14"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <!-- 系统快速状态 -->
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="今日摘要" Foreground="#E6EDF3" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                  <Border Style="{StaticResource SubCard}" Margin="0,0,0,8">
                    <DockPanel>
                      <Ellipse Width="8" Height="8" Fill="#3FB950" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="1 场活跃监测会议" Foreground="#E6EDF3" FontSize="12.5"/>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SubCard}" Margin="0,0,0,8">
                    <DockPanel>
                      <Ellipse Width="8" Height="8" Fill="#F85149" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="2 条待处置风险事件" Foreground="#E6EDF3" FontSize="12.5"/>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SubCard}">
                    <DockPanel>
                      <Ellipse Width="8" Height="8" Fill="#3FB950" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="3 / 4 检测服务在线" Foreground="#E6EDF3" FontSize="12.5"/>
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>

            <!-- 最近会议 -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="最近会议记录" Foreground="#E6EDF3" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <DataGrid ItemsSource="{Binding RecentMeetings}" MaxHeight="220">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="会议名称"  Binding="{Binding Name}"     Width="*"/>
                    <DataGridTextColumn Header="时间"      Binding="{Binding Time}"     Width="120"/>
                    <DataGridTextColumn Header="主持人"    Binding="{Binding Host}"     Width="80"/>
                    <DataGridTextColumn Header="风险事件"  Binding="{Binding RiskText}" Width="80"/>
                    <DataGridTemplateColumn Header="状态" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="#3FB95026"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Status}" Value="待复核">
                                    <Setter Property="Background" Value="#F6C95F26"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Status}" Value="已处置">
                                    <Setter Property="Background" Value="#58A6FF26"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Status}" FontSize="11.5">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#3FB950"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="待复核">
                                      <Setter Property="Foreground" Value="#F6C95F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="已处置">
                                      <Setter Property="Foreground" Value="#58A6FF"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ════════════════════════════════════════════════════
           Tab 1: 身份认证
           ════════════════════════════════════════════════════ -->
      <TabItem>
        <ScrollViewer Background="#0D1117" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24,28,24" MaxWidth="1000">
            <DockPanel Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="身份认证" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="用户登录与注册，管理个人安全档案及扰动模板" Foreground="#8B949E" FontSize="13" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>

            <!-- 已登录用户档案（启动时已经完成登录） -->
            <StackPanel>

              <!-- 用户信息卡 -->
              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <!-- 头像 -->
                  <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,20,0">
                    <Border.Background>
                      <SolidColorBrush Color="#58A6FF"/>
                    </Border.Background>
                    <TextBlock Text="{Binding UserAvatarLetter}" Foreground="White"
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <!-- 用户信息 -->
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSec}" Content="退出登录"
                            Command="{Binding DoLogoutCommand}" VerticalAlignment="Center" Padding="14,8"/>
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding UserDisplayName}" Foreground="#E6EDF3" FontSize="20" FontWeight="Bold" Margin="0,0,12,0"/>
                        <Border CornerRadius="4" Padding="8,2" Background="#58A6FF26" BorderBrush="#58A6FF66" BorderThickness="1">
                          <TextBlock Text="{Binding UserRoleText}" Foreground="#58A6FF" FontSize="12"/>
                        </Border>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding UserLoginTimeText}" Foreground="#8B949E" FontSize="12.5" Margin="0,0,20,0"/>
                        <TextBlock Text="{Binding UserCreatedAtText}" Foreground="#8B949E" FontSize="12.5"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Style="{StaticResource SubCard}" Margin="0,0,10,0" Padding="16,8">
                          <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding UserMeetingCountText}" Foreground="#58A6FF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="会议参与" Foreground="#8B949E" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                          </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SubCard}" Margin="0,0,10,0" Padding="16,8">
                          <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding UserDetectionCountText}" Foreground="#A98BFF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="历史检测" Foreground="#8B949E" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                          </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SubCard}" Padding="16,8">
                          <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding UserTemplateCountText}" Foreground="#3FB950" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="扰动模板" Foreground="#8B949E" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </DockPanel>
                </DockPanel>
              </Border>

              <!-- 面部扰动模板 -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="面部扰动模板库" Foreground="#E6EDF3" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                  <TextBlock Text="暂无模板，请前往「面部隐私保护」模块生成" Foreground="#8B949E" FontSize="13"
                             Visibility="{Binding UserTemplates.Count, Converter={StaticResource ZeroToVis}}"/>
                  <ItemsControl ItemsSource="{Binding UserTemplates}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SubCard}" Margin="0,0,10,10" Width="220">
                          <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                              <Border CornerRadius="4" Padding="5,2" Background="#3FB95026" DockPanel.Dock="Right">
                                <TextBlock Text="{Binding Status}" Foreground="#3FB950" FontSize="11"/>
                              </Border>
                              <TextBlock Text="{Binding TemplateId}" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Description}" Foreground="#8B949E" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CreatedDate, StringFormat='{}创建于 {0}'}" Foreground="#444D56" FontSize="11.5"/>
                            <TextBlock Text="{Binding PhotoCount, StringFormat='{}使用照片：{0} 张'}" Foreground="#444D56" FontSize="11.5"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- 历史检测记录 -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="历史检测记录" Foreground="#E6EDF3" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                  <DataGrid ItemsSource="{Binding UserDetectionHistory}" MaxHeight="240">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="会议 ID"    Binding="{Binding MeetingId}"  Width="*"/>
                      <DataGridTextColumn Header="时间"        Binding="{Binding Time}"       Width="100"/>
                      <DataGridTextColumn Header="检测类型"    Binding="{Binding RiskTypes}"  Width="100"/>
                      <DataGridTextColumn Header="风险级别"    Binding="{Binding Level}"      Width="80"/>
                      <DataGridTextColumn Header="处置状态"    Binding="{Binding Status}"     Width="80"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>

              <!-- 认证日志 + 策略 -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Grid.Column="0">
                  <StackPanel>
                    <TextBlock Text="最近认证日志" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding AuthLogs}" MaxHeight="200">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="时间"  Binding="{Binding Time}"   Width="70"/>
                        <DataGridTextColumn Header="用户"  Binding="{Binding User}"   Width="80"/>
                        <DataGridTextColumn Header="操作"  Binding="{Binding Action}" Width="80"/>
                        <DataGridTextColumn Header="结果"  Binding="{Binding Result}" Width="50"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="2">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                      <TextBlock Text="安全策略" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                      <Button DockPanel.Dock="Right" Style="{StaticResource BtnSec}" Content="保存策略"
                              Command="{Binding SaveAuthPolicyCommand}" Padding="10,6" FontSize="12"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding AuthPolicies}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="6"
                                  Background="{Binding EnabledBg, Converter={StaticResource ColorBrush}}"
                                  BorderBrush="{Binding EnabledBorder, Converter={StaticResource ColorBrush}}"
                                  BorderThickness="1">
                            <DockPanel>
                              <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2"
                                      Background="{Binding EnabledBg, Converter={StaticResource ColorBrush}}">
                                <TextBlock Text="{Binding EnabledText}" FontSize="11"
                                           Foreground="{Binding EnabledFg, Converter={StaticResource ColorBrush}}"/>
                              </Border>
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="#E6EDF3" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Foreground="#8B949E" FontSize="11.5" Margin="0,3,0,0"/>
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ════════════════════════════════════════════════════
           Tab 2: 视频会议采样
           ════════════════════════════════════════════════════ -->
      <TabItem>
        <Grid Background="#0D1117" Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,24" MaxWidth="1100">
              <!-- 页头 -->
              <DockPanel Margin="0,0,0,20">
                <StackPanel>
                  <TextBlock Text="视频会议采样" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold"/>
                  <TextBlock Text="配置采集源，实时预览画面帧及音频波形" Foreground="#8B949E" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" CornerRadius="6" Padding="12,6" VerticalAlignment="Center"
                        Background="{Binding DashboardStatusBrush}">
                  <TextBlock Text="{Binding DashboardStatusText}" Foreground="White" FontSize="12.5"/>
                </Border>
              </DockPanel>

              <!-- 连接配置 + 采集控制 -->
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="后端连接配置" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock Text="AIGC 检测服务地址" Foreground="#8B949E" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding AigcGatewayUrl, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding AigcConnectionHint}" Foreground="#444D56" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <Button Style="{StaticResource BtnBlue}" Content="连接并测试" Command="{Binding ConnectCommand}" Margin="0,0,8,0" Padding="14,8"/>
                      <Button Style="{StaticResource BtnSec}" Content="断  开" Command="{Binding DisconnectCommand}" Padding="14,8"/>
                    </StackPanel>
                    <Border Style="{StaticResource SubCard}" Margin="0,12,0,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#8B949E" FontSize="12.5"/>
                        <TextBlock Text=" · " Foreground="#444D56" Margin="8,0"/>
                        <TextBlock Text="{Binding ThroughputText}" Foreground="#8B949E" FontSize="12.5"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="采集控制" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="捕获窗口" Foreground="#8B949E" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox Style="{StaticResource ComboInput}"
                                  ItemsSource="{Binding Windows}"
                                  SelectedItem="{Binding SelectedWindow}"
                                  DisplayMemberPath="DisplayName"/>
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource BtnSec}" Content="↺ 刷新"
                              Command="{Binding RefreshWindowsCommand}" VerticalAlignment="Bottom" Padding="12,8"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <Button Style="{StaticResource Btn}" Content="▶ 开始采集" Command="{Binding StartCaptureCommand}" Margin="0,0,8,0" Padding="14,8"/>
                      <Button Style="{StaticResource BtnRed}" Content="⏹ 停止采集" Command="{Binding StopCaptureCommand}" Padding="14,8"/>
                    </StackPanel>
                    <Border Style="{StaticResource SubCard}" Margin="0,12,0,0">
                      <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CaptureStatusText}" Foreground="#8B949E" FontSize="12.5" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding CurrentFpsText}" Foreground="#8B949E" FontSize="12.5" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding DropAndRttText}" Foreground="#8B949E" FontSize="12.5"/>
                      </WrapPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- 视频预览 + 音频可视化 -->
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 视频预览 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="300">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                      <TextBlock Text="实时视频预览" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding FrameFeedStatusText}"
                                 Foreground="#8B949E" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#0D111788" CornerRadius="6" MinHeight="320">
                      <Grid>
                        <Image Source="{Binding LiveFrameImage}" Stretch="Uniform"
                               Visibility="{Binding LiveFrameImage, Converter={StaticResource NotNullToVis}}"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding LiveFrameImage, Converter={StaticResource NullToVis}}">
                          <TextBlock Text="📹" FontSize="36" HorizontalAlignment="Center"/>
                          <TextBlock Text="等待采集开始…" Foreground="#8B949E" FontSize="13" Margin="0,10,0,0"
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Padding="8,4"
                                Background="#CC000000" CornerRadius="4">
                          <TextBlock Text="{Binding LiveFrameMetaText}" Foreground="#E6EDF3" FontSize="11.5"/>
                        </Border>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <!-- 音频可视化 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="音频采集可视化" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <!-- 均衡器条 -->
                    <Border Background="#0D111788" CornerRadius="6" Padding="12,16" Margin="0,0,0,12" Height="160">
                      <Grid VerticalAlignment="Bottom">
                        <UniformGrid Rows="1" VerticalAlignment="Bottom" Height="120">
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar0}" Background="#58A6FF"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar1}" Background="#58A6FF"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar2}" Background="#67C8A0"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar3}" Background="#3FB950"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar4}" Background="#3FB950"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar5}" Background="#F6C95F"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar6}" Background="#F6C95F"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar7}" Background="#3FB950"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar8}" Background="#3FB950"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar9}" Background="#67C8A0"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar10}" Background="#58A6FF"/>
                          <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                  Height="{Binding AudioBar11}" Background="#58A6FF"/>
                        </UniformGrid>
                      </Grid>
                    </Border>
                    <DockPanel Margin="0,0,0,12">
                      <TextBlock Text="{Binding AudioLevelDbText}" Foreground="#58A6FF" FontSize="22" FontWeight="Bold"/>
                      <TextBlock Text="输入电平" Foreground="#8B949E" FontSize="12" VerticalAlignment="Bottom" Margin="8,0,0,3" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <Button Content="{Binding AudioBtnText}"
                            Command="{Binding ToggleAudioCommand}" HorizontalAlignment="Stretch" Padding="0,9">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAudioActive}" Value="True">
                              <Setter Property="Background" Value="#B62324"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- 最近帧缩略图 -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="最近采集帧" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                  <ItemsControl ItemsSource="{Binding RecentFrames}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#161B22" CornerRadius="6" Margin="0,0,10,10" Padding="6"
                                BorderBrush="#30363D" BorderThickness="1" Width="160">
                          <StackPanel>
                            <Image Source="{Binding Image}" Height="100" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding FrameText}" Foreground="#58A6FF" FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding TimeText}" Foreground="#8B949E" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="尚未采集帧，请先开始采集" Foreground="#8B949E" FontSize="12.5"
                             Visibility="{Binding RecentFrames.Count, Converter={StaticResource ZeroToVis}}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ════════════════════════════════════════════════════
           Tab 3: 面部隐私保护
           ════════════════════════════════════════════════════ -->
      <TabItem>
        <TabItem.DataContext><Binding Path="FaceProtect"/></TabItem.DataContext>
        <ScrollViewer Background="#0D1117" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24,28,24" MaxWidth="1100">
            <!-- 页头 + 连接状态 -->
            <DockPanel Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="面部隐私保护" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="对抗扰动保护人脸隐私，防止 AI 识别。通过 OBS 虚拟摄像头输出至会议软件" Foreground="#8B949E" FontSize="13" Margin="0,4,0,0"/>
              </StackPanel>
              <Border DockPanel.Dock="Right" CornerRadius="6" Padding="12,6" VerticalAlignment="Center"
                      Background="{Binding BackendStatusColor, Converter={x:Static vm:ColorStringToBrushConverter.Instance}}">
                <TextBlock Text="{Binding IsBackendConnected, Converter={x:Static vm:BoolToConnectedTextConverter.Instance}}"
                           Foreground="White" FontSize="12.5"/>
              </Border>
            </DockPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- 左列：后端连接 + 照片上传 + 参数 + 生成 -->
              <StackPanel Grid.Column="0">
                <!-- 后端连接 -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="后端连接" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="FaceProtect 服务地址" Foreground="#8B949E" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding FaceProtectGatewayUrl, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10"/>
                    <Button Style="{StaticResource BtnBlue}" Content="连接并检测" Command="{Binding TestConnectionCommand}" Padding="14,8"/>
                    <TextBlock Text="{Binding BackendStatusText}" Foreground="#8B949E" FontSize="12" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>

                <!-- 照片上传 -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                      <TextBlock Text="上传人脸照片 (3-5 张)" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding UploadCountText}"
                                 Foreground="#58A6FF" FontSize="13" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 照片缩略图区 -->
                    <Border Background="#0D111788" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                            MinHeight="110" BorderBrush="#30363D" BorderThickness="1">
                      <Grid>
                        <!-- 空状态提示 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding UploadedPhotos.Count, Converter={StaticResource ZeroToVis}}">
                          <TextBlock Text="🖼" FontSize="28" HorizontalAlignment="Center"/>
                          <TextBlock Text="点击下方按钮上传照片" Foreground="#8B949E" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <!-- 缩略图列表 -->
                        <ItemsControl ItemsSource="{Binding UploadedPhotos}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="4" CornerRadius="6" ClipToBounds="True" Width="90" Height="90">
                                <Grid>
                                  <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                  <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="4,2">
                                    <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="9.5"
                                               TextTrimming="CharacterEllipsis"/>
                                  </Border>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>

                    <TextBlock Text="{Binding UploadStatusText}" Foreground="#8B949E" FontSize="12" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource BtnBlue}" Content="📁 选择照片" Command="{Binding UploadPhotosCommand}" Margin="0,0,8,0" Padding="14,8"/>
                      <Button Style="{StaticResource BtnSec}" Content="清  除" Command="{Binding ClearPhotosCommand}" Padding="14,8"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- 离线生成参数 -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="扰动生成参数" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="用户名（必填，可输入新用户）" Foreground="#8B949E" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding GenerateUserName, UpdateSourceTrigger=PropertyChanged}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="计算设备" Foreground="#8B949E" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox Style="{StaticResource ComboInput}"
                                  SelectedValue="{Binding GenerateDevice}"
                                  SelectedValuePath="Content">
                          <ComboBoxItem Content="cuda:0"/>
                          <ComboBoxItem Content="cuda:1"/>
                          <ComboBoxItem Content="cpu"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="扰动强度 ε（推荐 16）" Foreground="#8B949E" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource Input}" Text="{Binding GenerateEps, UpdateSourceTrigger=PropertyChanged}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="迭代次数（推荐 200）" Foreground="#8B949E" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource Input}" Text="{Binding GenerateIters, UpdateSourceTrigger=PropertyChanged}"/>
                      </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource Btn}" Content="▶ 开始生成扰动模板"
                            Command="{Binding StartGenerationCommand}"
                            IsEnabled="{Binding IsGenerating, Converter={StaticResource BoolNeg}}"
                            HorizontalAlignment="Stretch" Padding="0,10"/>
                    <!-- 进度 -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                      <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding GenerateStatusText}" Foreground="#8B949E" FontSize="12"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding GenerateProgressText}" Foreground="#58A6FF" FontSize="12" FontWeight="Bold"/>
                      </DockPanel>
                      <ProgressBar Style="{StaticResource PBar}" Value="{Binding GenerateProgress}" Maximum="100" Height="8"/>
                    </StackPanel>
                    <!-- 生成日志 -->
                    <Border Style="{StaticResource SubCard}" Margin="0,12,0,0" MaxHeight="100">
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding GenerationLogText}" Foreground="#8B949E" FontSize="11.5" TextWrapping="Wrap"/>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- 右列：在线保护 + 画面预览 + 用户模板库 -->
              <StackPanel Grid.Column="2">
                <!-- 独立预览窗口 -->
                <Border Background="#3FB9500D" BorderBrush="#3FB95033" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                  <DockPanel>
                    <StackPanel>
                      <TextBlock Text="🛡 独立保护预览窗口（OBS 捕获）" Foreground="#3FB950" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                      <TextBlock Text="弹出独立浮窗，OBS 直接捕获该窗口作为虚拟摄像头输入" Foreground="#8B949E" FontSize="12"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}"
                            Content="{Binding PreviewWindowBtnText}"
                            Command="{Binding TogglePreviewWindowCommand}"
                            VerticalAlignment="Center" Padding="14,8"/>
                  </DockPanel>
                </Border>

                <!-- 在线保护控制 -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="实时摄像头保护" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,12" Padding="12,9">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="📷 摄像头 0" Foreground="#8B949E" FontSize="12"/>
                        <TextBlock Foreground="#E6EDF3" FontSize="12.5">
                          <Run Text="保护用户："/>
                          <Run Text="{Binding GenerateUserName}" Foreground="#58A6FF" FontWeight="SemiBold"/>
                          <Run Text="  （与上方扰动生成的用户名一致）" Foreground="#444D56" FontSize="11"/>
                        </TextBlock>
                      </DockPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                      <Button Style="{StaticResource Btn}" Content="▶ 开启保护" Command="{Binding StartOnlineCommand}"
                              IsEnabled="{Binding IsProtecting, Converter={StaticResource BoolNeg}}"
                              Margin="0,0,8,0" Padding="14,8"/>
                      <Button Style="{StaticResource BtnRed}" Content="⏹ 停止保护" Command="{Binding StopOnlineCommand}"
                              IsEnabled="{Binding IsProtecting}" Padding="14,8"/>
                    </StackPanel>
                    <!-- 保护状态 -->
                    <Border Style="{StaticResource SubCard}">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding OnlineLatencyText}" Foreground="#58A6FF" FontSize="12.5" HorizontalAlignment="Right"/>
                          <TextBlock Text="{Binding OnlineFramesText}" Foreground="#8B949E" FontSize="11.5" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="{Binding OnlineStatusText}" Foreground="#3FB950" FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#3FB950"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsProtecting}" Value="False">
                                    <Setter Property="Foreground" Value="#8B949E"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding PreviewStatusText}" Foreground="#8B949E" FontSize="11.5" Margin="0,4,0,0"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- 双画面预览 -->
                <Border Style="{StaticResource Card}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#0D111788" CornerRadius="6" MinHeight="160">
                      <Grid>
                        <Image Source="{Binding OriginalFrameImage}" Stretch="Uniform"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding OriginalFrameImage, Converter={StaticResource NullToVis}}">
                          <TextBlock Text="📷" FontSize="28" HorizontalAlignment="Center"/>
                          <TextBlock Text="原始画面" Foreground="#8B949E" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6" Padding="5,2"
                                Background="#0D111788" CornerRadius="4">
                          <TextBlock Text="原  始" Foreground="#E6EDF3" FontSize="11"/>
                        </Border>
                      </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#30363D" CornerRadius="2"/>
                    <Border Grid.Column="2" Background="#0D111788" CornerRadius="6">
                      <Grid>
                        <Image Source="{Binding ProtectedFrameImage}" Stretch="Uniform"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding ProtectedFrameImage, Converter={StaticResource NullToVis}}">
                          <TextBlock Text="🛡" FontSize="28" HorizontalAlignment="Center"/>
                          <TextBlock Text="已保护画面" Foreground="#3FB950" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6" Padding="5,2"
                                Background="#0D111788" CornerRadius="4">
                          <TextBlock Text="已保护" Foreground="#3FB950" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <!-- 用户模板库 -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                      <TextBlock Text="用户模板库" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                      <Button DockPanel.Dock="Right" Style="{StaticResource BtnSec}" Content="↺ 刷新"
                              Command="{Binding RefreshUserListCommand}" Padding="10,6" FontSize="12"/>
                    </DockPanel>
                    <ListBox Background="Transparent" BorderThickness="0" MaxHeight="160"
                             ItemsSource="{Binding UserList}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,7">
                            <DockPanel>
                              <Border CornerRadius="4" Padding="6,2" Background="#3FB95026" DockPanel.Dock="Right">
                                <TextBlock Text="✓ 模板就绪" Foreground="#3FB950" FontSize="11"/>
                              </Border>
                              <TextBlock Text="{Binding}" Foreground="#E6EDF3" FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="暂无用户模板，请先完成离线生成" Foreground="#8B949E" FontSize="12.5"
                               Visibility="{Binding UserList.Count, Converter={StaticResource ZeroToVis}}"/>
                  </StackPanel>
                </Border>

                <!-- 图片单张测试 -->
                <Border Style="{StaticResource Card}">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Width="140">
                      <Image Source="{Binding SingleOriginalImage}" Height="80" Stretch="Uniform" Margin="0,0,0,6"/>
                      <Image Source="{Binding SingleProtectedImage}" Height="80" Stretch="Uniform"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="单张图片保护测试" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                      <TextBlock Text="{Binding SingleStatusText}" Foreground="#8B949E" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>
                      <Button Style="{StaticResource BtnSec}" Content="📂 选择并保护"
                              Command="{Binding ProtectSingleImageCommand}" Padding="14,8"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ════════════════════════════════════════════════════
           Tab 4: AIGC 视频检测
           ════════════════════════════════════════════════════ -->
      <TabItem>
        <Grid Background="#0D1117">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,24" MaxWidth="1100">
              <!-- 页头 -->
              <DockPanel Margin="0,0,0,20">
                <StackPanel>
                  <TextBlock Text="AIGC 视频检测" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold"/>
                  <TextBlock Text="FakeSTormer 实时 AI 伪造视频检测，时序分析识别深度伪造内容" Foreground="#8B949E" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" CornerRadius="6" Padding="12,6" VerticalAlignment="Center"
                        Background="{Binding DashboardStatusBrush}">
                  <TextBlock Text="{Binding DashboardStatusText}" Foreground="White" FontSize="12.5"/>
                </Border>
              </DockPanel>

              <!-- 三列主布局 -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="260"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- 左列：连接 + 风险评估 -->
                <StackPanel Grid.Column="0">
                  <!-- 连接配置 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="检测后端" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                      <TextBlock Text="AIGC 检测服务地址" Foreground="#8B949E" FontSize="11.5" Margin="0,0,0,4"/>
                      <TextBox Style="{StaticResource Input}"
                               Text="{Binding AigcGatewayUrl, UpdateSourceTrigger=PropertyChanged}"
                               Margin="0,0,0,8"/>
                      <Button Style="{StaticResource BtnBlue}" Content="连接并测试" Command="{Binding ConnectCommand}"
                              HorizontalAlignment="Stretch" Padding="0,8" Margin="0,0,0,8"/>
                      <Button Style="{StaticResource Btn}" Content="▶ 开始检测"
                              Command="{Binding StartCaptureCommand}"
                              HorizontalAlignment="Stretch" Padding="0,8" Margin="0,0,0,6"/>
                      <Button Style="{StaticResource BtnRed}" Content="⏹ 停止检测"
                              Command="{Binding StopCaptureCommand}"
                              HorizontalAlignment="Stretch" Padding="0,8"/>
                    </StackPanel>
                  </Border>

                  <!-- 风险等级 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="当前风险等级" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>
                      <Border CornerRadius="8" Padding="0,16" Background="{Binding RiskBadgeBrush}" Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Center">
                          <TextBlock Text="{Binding RiskBadgeText}" Foreground="White" FontSize="26"
                                     FontWeight="Bold" HorizontalAlignment="Center"/>
                          <TextBlock Text="{Binding LastRiskTypeText}" Foreground="White" FontSize="11"
                                     HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8"/>
                        </StackPanel>
                      </Border>
                      <ProgressBar Style="{StaticResource PBar}" Value="{Binding RiskProgress}" Maximum="100" Margin="0,0,0,12"/>
                      <TextBlock Text="{Binding LastRiskMessageText}" Foreground="#8B949E" FontSize="11.5"
                                 TextWrapping="Wrap" Margin="0,0,0,10"/>
                      <TextBlock Text="{Binding DetectorRuntimeText}" Foreground="#8B949E" FontSize="11.5" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>

                  <!-- 真实性评估 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="真实性评估" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>
                      <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Width="60" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding AuthenticityText}" Foreground="#3FB950" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                          <TextBlock Text="真实" Foreground="#8B949E" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="画面真实度" Foreground="#8B949E" FontSize="12" Margin="0,0,0,5"/>
                          <ProgressBar Style="{StaticResource PBarGreen}" Value="{Binding VideoAuthenticityPercent}" Maximum="100"/>
                        </StackPanel>
                      </DockPanel>
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Width="60" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding FakeProbabilityText}" Foreground="#F85149" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                          <TextBlock Text="伪造" Foreground="#8B949E" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="AIGC 伪造概率" Foreground="#8B949E" FontSize="12" Margin="0,0,0,5"/>
                          <ProgressBar Style="{StaticResource PBarOrange}" Value="{Binding FakeProbabilityPercent}" Maximum="100" Foreground="#F85149"/>
                        </StackPanel>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- 中列：视频预览 + 分数波形 -->
                <StackPanel Grid.Column="2">
                  <!-- 视频帧预览 -->
                  <Border Style="{StaticResource Card}" MinHeight="280">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="实时视频帧" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FrameFeedStatusText}" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center"/>
                      </DockPanel>
                      <Border Grid.Row="1" Background="#0D111788" CornerRadius="6" MinHeight="320">
                        <Grid>
                          <Image Source="{Binding LiveFrameImage}" Stretch="Uniform"
                                 Visibility="{Binding LiveFrameImage, Converter={StaticResource NotNullToVis}}"/>
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding LiveFrameImage, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="等待采集帧…" Foreground="#8B949E" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                          </StackPanel>
                          <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Padding="8,4"
                                  Background="#CC000000" CornerRadius="4">
                            <TextBlock Text="{Binding LiveFrameMetaText}" Foreground="#E6EDF3" FontSize="11.5"/>
                          </Border>
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>

                  <!-- 异常分数波形 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="AIGC 异常分数波形" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding WaveformSessionLabel}"
                                   Foreground="#8B949E" FontSize="12" VerticalAlignment="Center"/>
                      </DockPanel>
                      <Border Background="#0D111788" CornerRadius="6" Height="170"
                              ClipToBounds="True" Padding="0">
                        <Grid>
                          <!-- 网格刻度（让起伏感更明显） -->
                          <Canvas Width="600" Height="150" Margin="0,10,0,10"
                                  HorizontalAlignment="Center" ClipToBounds="True">
                            <!-- 顶部参考 1.0 -->
                            <Line X1="0" Y1="0" X2="600" Y2="0"
                                  Stroke="#30363D" StrokeThickness="1" Opacity="0.4"/>
                            <!-- 危险线 0.75 -->
                            <Line X1="0" Y1="37.5" X2="600" Y2="37.5"
                                  Stroke="#F85149" StrokeThickness="1" StrokeDashArray="4,3" Opacity="0.55"/>
                            <!-- 阈值参考线 0.5 -->
                            <Line X1="0" Y1="75" X2="600" Y2="75"
                                  Stroke="#F6C95F" StrokeThickness="1" StrokeDashArray="4,3" Opacity="0.6"/>
                            <!-- 低风险线 0.25 -->
                            <Line X1="0" Y1="112.5" X2="600" Y2="112.5"
                                  Stroke="#3FB950" StrokeThickness="1" StrokeDashArray="4,3" Opacity="0.45"/>
                            <!-- 底部参考 0.0 -->
                            <Line X1="0" Y1="150" X2="600" Y2="150"
                                  Stroke="#30363D" StrokeThickness="1" Opacity="0.4"/>
                            <!-- 波形折线 -->
                            <Polyline Points="{Binding ScoreWaveformPoints}"
                                      Stroke="#58A6FF" StrokeThickness="2.2" Fill="Transparent"/>
                          </Canvas>
                          <!-- 右侧刻度文字 -->
                          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                      Margin="0,8,8,8">
                            <TextBlock Text="1.0" Foreground="#444D56" FontSize="10"/>
                            <TextBlock Text="0.75" Foreground="#F85149" FontSize="10" Margin="0,28,0,0" Opacity="0.7"/>
                            <TextBlock Text="0.5"  Foreground="#F6C95F" FontSize="10" Margin="0,28,0,0" Opacity="0.7"/>
                            <TextBlock Text="0.25" Foreground="#3FB950" FontSize="10" Margin="0,28,0,0" Opacity="0.7"/>
                            <TextBlock Text="0.0"  Foreground="#444D56" FontSize="10" Margin="0,28,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                      <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding CurrentScoreDispText, StringFormat='{}当前分数：{0}'}"
                                   Foreground="#58A6FF" FontSize="14" FontWeight="Bold"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button Style="{StaticResource BtnSec}" Content="📥 导出数据"
                                  Command="{Binding ExportDetectionDataCommand}" Margin="0,0,8,0" Padding="10,6" FontSize="12"/>
                          <Button Style="{StaticResource BtnSec}" Content="📄 生成报告"
                                  Command="{Binding ExportDetectionReportCommand}" Padding="10,6" FontSize="12"/>
                        </StackPanel>
                      </DockPanel>
                    </StackPanel>
                  </Border>

                  <!-- 检测统计 -->
                  <Border Style="{StaticResource Card}">
                    <WrapPanel>
                      <Border Style="{StaticResource SubCard}" Margin="0,0,10,8" Padding="16,10">
                        <StackPanel>
                          <TextBlock Text="{Binding DetectionCountText}" Foreground="#58A6FF" FontSize="16" FontWeight="Bold"/>
                          <TextBlock Text="累计检测帧" Foreground="#8B949E" FontSize="11.5" Margin="0,4,0,0"/>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource SubCard}" Margin="0,0,10,8" Padding="16,10">
                        <StackPanel>
                          <TextBlock Text="{Binding ThroughputText}" Foreground="#3FB950" FontSize="16" FontWeight="Bold"/>
                          <TextBlock Text="帧吞吐量" Foreground="#8B949E" FontSize="11.5" Margin="0,4,0,0"/>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource SubCard}" Margin="0,0,0,8" Padding="16,10">
                        <StackPanel>
                          <TextBlock Text="{Binding DropAndRttText}" Foreground="#F6C95F" FontSize="16" FontWeight="Bold"/>
                          <TextBlock Text="丢帧 / RTT" Foreground="#8B949E" FontSize="11.5" Margin="0,4,0,0"/>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </Border>
                </StackPanel>

                <!-- 右列：检测记录 + 告警 -->
                <StackPanel Grid.Column="4">
                  <!-- 最近检测结果 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="最近检测记录" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                      <ItemsControl ItemsSource="{Binding RecentDetections}" MaxHeight="240">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="0,0,0,5" CornerRadius="6" Padding="10,7" Background="#21262D"
                                    BorderBrush="#30363D" BorderThickness="1">
                              <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="4" Width="32" Height="32"
                                        Background="{Binding RiskBrush}" Margin="6,0,0,0">
                                  <TextBlock Text="{Binding RiskText}" Foreground="White" FontSize="9"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <StackPanel>
                                  <TextBlock Text="{Binding IndexText}" Foreground="#58A6FF" FontSize="12" FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding ScoreText}" Foreground="#F6C95F" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                                  <TextBlock Text="{Binding TimeText}" Foreground="#8B949E" FontSize="11"/>
                                </StackPanel>
                              </DockPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="等待检测结果…" Foreground="#8B949E" FontSize="12.5"
                                 Visibility="{Binding RecentDetections.Count, Converter={StaticResource ZeroToVis}}"/>
                    </StackPanel>
                  </Border>

                  <!-- 异常线索 / 告警 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="异常线索告警" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Alerts}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="0,0,0,5" CornerRadius="6" Padding="10,7" Background="#F8514910"
                                      BorderBrush="#F8514933" BorderThickness="1">
                                <StackPanel>
                                  <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                               Foreground="#444D56" FontSize="11"/>
                                    <TextBlock Text="{Binding RiskLevel}" Foreground="#F85149" FontSize="12" FontWeight="SemiBold"/>
                                  </DockPanel>
                                  <TextBlock Text="{Binding Message}" Foreground="#8B949E" FontSize="11.5"
                                             TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="暂无异常告警" Foreground="#8B949E" FontSize="12.5"
                                 Visibility="{Binding Alerts.Count, Converter={StaticResource ZeroToVis}}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ════════════════════════════════════════════════════
           Tab 5: 语义风险识别
           ════════════════════════════════════════════════════ -->
      <TabItem>
        <Grid Background="#0D1117">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,24" MaxWidth="1100">
              <!-- 页头 -->
              <DockPanel Margin="0,0,0,20">
                <StackPanel>
                  <TextBlock Text="实时语义风险识别" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold"/>
                  <TextBlock Text="说话人分离 · 语音实时转文字 · 语义风险等级检测" Foreground="#8B949E" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" CornerRadius="6" Padding="12,6" VerticalAlignment="Center"
                        Background="{Binding SemanticStatusBg}">
                  <TextBlock Text="{Binding SemanticStatusText}" Foreground="White" FontSize="12.5"/>
                </Border>
              </DockPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="320"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左列 -->
                <StackPanel Grid.Column="0">
                  <!-- 会话控制 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="语义识别服务" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                      <TextBlock Text="网关地址" Foreground="#8B949E" FontSize="12" Margin="0,0,0,5"/>
                      <TextBox Style="{StaticResource Input}" Text="{Binding SemanticGatewayUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Content="▶ 开始会话"
                                Command="{Binding SemanticStartSessionCommand}" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Style="{StaticResource BtnRed}" Content="⏹ 结束"
                                Command="{Binding SemanticStopSessionCommand}" Padding="14,8"/>
                      </StackPanel>
                      <Border Style="{StaticResource SubCard}" Margin="0,12,0,0">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding SemanticEventCount}"
                                     Foreground="#F6C95F" FontSize="13" FontWeight="Bold"/>
                          <TextBlock Text="风险事件" Foreground="#8B949E" FontSize="12.5"/>
                        </DockPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- 说话人列表 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="说话人分析" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                      <ItemsControl ItemsSource="{Binding Speakers}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8"
                                    Background="{Binding AvatarBg, Converter={StaticResource ColorBrush}}"
                                    BorderBrush="#30363D" BorderThickness="1">
                              <DockPanel>
                                <Border CornerRadius="4" Padding="6,2" DockPanel.Dock="Right"
                                        Background="{Binding RiskBg, Converter={StaticResource ColorBrush}}"
                                        BorderBrush="{Binding RiskBorder, Converter={StaticResource ColorBrush}}"
                                        BorderThickness="1">
                                  <TextBlock Text="{Binding RiskTag}"
                                             Foreground="{Binding RiskFg, Converter={StaticResource ColorBrush}}" FontSize="11"/>
                                </Border>
                                <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0"
                                        Background="{Binding AvatarBg, Converter={StaticResource ColorBrush}}">
                                  <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="Bold"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Role}" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding Name}" Foreground="#8B949E" FontSize="11.5" Margin="0,2,0,0"/>
                                  <TextBlock Text="{Binding SpeakPercent, StringFormat={}发言占比 {0}%}" Foreground="#8B949E" FontSize="11"/>
                                </StackPanel>
                              </DockPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- 风险事件 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="风险事件时间轴" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                      <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SemanticRiskEvents}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="0,0,0,7" CornerRadius="6" Padding="10,8"
                                      Background="#F8514910" BorderBrush="#F8514933" BorderThickness="1">
                                <StackPanel>
                                  <DockPanel>
                                    <Border CornerRadius="3" Padding="5,1" Background="#F8514933" DockPanel.Dock="Right">
                                      <TextBlock Text="{Binding Level}" Foreground="#F85149" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Time}" Foreground="#444D56" FontSize="11.5" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Speaker}" Foreground="#8B949E" FontSize="11.5"/>
                                  </DockPanel>
                                  <TextBlock Text="{Binding RiskType}" Foreground="#E6EDF3" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                  <TextBlock Text="{Binding Summary}" Foreground="#8B949E" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="暂无风险事件" Foreground="#8B949E" FontSize="12.5"
                                 Visibility="{Binding SemanticRiskEvents.Count, Converter={StaticResource ZeroToVis}}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- 右列：转录 + 会话摘要 -->
                <StackPanel Grid.Column="2">
                  <!-- 实时转录 -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="实时语音转录" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button Style="{StaticResource BtnSec}" Content="清空" Command="{Binding ClearTranscriptCommand}"
                                  Margin="0,0,6,0" Padding="10,6" FontSize="12"/>
                          <Button Style="{StaticResource BtnSec}" Content="📥 导出" Command="{Binding ExportTranscriptCommand}"
                                  Padding="10,6" FontSize="12"/>
                        </StackPanel>
                      </DockPanel>
                      <Border Background="#0D111788" CornerRadius="6" Padding="14" Height="280"
                              BorderBrush="#30363D" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding TranscriptLines}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#C9D1D9" FontSize="13"
                                           FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,6"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- 会话结束摘要（含饼图） -->
                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ShowSemanticSummary}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock Text="会话风险分析摘要" Foreground="#E6EDF3" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="160"/>
                          <ColumnDefinition Width="20"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 饼图 -->
                        <Canvas Width="140" Height="140">
                          <Path Data="{Binding SemPieHighPath}" Fill="#F85149"/>
                          <Path Data="{Binding SemPieMedPath}"  Fill="#F6C95F"/>
                          <Path Data="{Binding SemPieLowPath}"  Fill="#3FB950"/>
                          <Path Data="{Binding SemPieInfoPath}" Fill="#58A6FF"/>
                          <Ellipse Width="70" Height="70" Fill="#161B22" Canvas.Left="35" Canvas.Top="35"/>
                          <TextBlock Text="{Binding SemSumTotalText}" Foreground="#E6EDF3" FontSize="9"
                                     Canvas.Left="35" Canvas.Top="63" Width="70" TextAlignment="Center"/>
                        </Canvas>
                        <!-- 图例 + 统计 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding SemSumDurationText, StringFormat='{}会话时长：{0}'}"
                                       Foreground="#8B949E" FontSize="13"/>
                          </DockPanel>
                          <UniformGrid Columns="2" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                              <Border Width="12" Height="12" Background="#F85149" CornerRadius="3" Margin="0,1,8,0"/>
                              <TextBlock Text="{Binding SemSumHighText, StringFormat='{}高风险：{0} 条'}" Foreground="#E6EDF3" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,8">
                              <Border Width="12" Height="12" Background="#F6C95F" CornerRadius="3" Margin="0,1,8,0"/>
                              <TextBlock Text="{Binding SemSumMedText, StringFormat='{}中风险：{0} 条'}" Foreground="#E6EDF3" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                              <Border Width="12" Height="12" Background="#3FB950" CornerRadius="3" Margin="0,1,8,0"/>
                              <TextBlock Text="{Binding SemSumLowText, StringFormat='{}低风险：{0} 条'}" Foreground="#E6EDF3" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,8">
                              <Border Width="12" Height="12" Background="#58A6FF" CornerRadius="3" Margin="0,1,8,0"/>
                              <TextBlock Text="{Binding SemSumInfoText, StringFormat='{}信息：{0} 条'}" Foreground="#E6EDF3" FontSize="13"/>
                            </StackPanel>
                          </UniformGrid>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ════════════════════════════════════════════════════
           Tab 6: 数据统计分析
           ════════════════════════════════════════════════════ -->
      <TabItem>
        <ScrollViewer Background="#0D1117" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,24,28,24" MaxWidth="1100">
            <!-- 页头 -->
            <DockPanel Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="数据统计分析" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="历史检测数据统计、实时资源监控与检测报告导出" Foreground="#8B949E" FontSize="13" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="6" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Padding="2">
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BtnSec}" Content="📊 Excel" Command="{Binding ExportExcelCommand}" Padding="12,7" FontSize="12.5"/>
                    <Border Width="1" Background="#30363D" Margin="0,4"/>
                    <Button Style="{StaticResource BtnSec}" Content="📄 PDF"   Command="{Binding ExportPdfCommand}"   Padding="12,7" FontSize="12.5"/>
                    <Border Width="1" Background="#30363D" Margin="0,4"/>
                    <Button Style="{StaticResource BtnSec}" Content="🗒 审计 JSON" Command="{Binding ExportAuditCommand}" Padding="12,7" FontSize="12.5"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DockPanel>

            <!-- KPI 四格 -->
            <UniformGrid Columns="4" Margin="0,0,0,0">
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="{Binding StatMeetingCount}" Foreground="#58A6FF" FontSize="36" FontWeight="Bold"/>
                  <TextBlock Text="历史会议场次" Foreground="#8B949E" FontSize="12.5" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="{Binding StatEventCount}" Foreground="#F6C95F" FontSize="36" FontWeight="Bold"/>
                  <TextBlock Text="累计风险事件" Foreground="#8B949E" FontSize="12.5" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="{Binding StatAvgRisk}" Foreground="#A98BFF" FontSize="36" FontWeight="Bold"/>
                  <TextBlock Text="平均风险评分" Foreground="#8B949E" FontSize="12.5" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding StatResolveRate}" Foreground="#3FB950" FontSize="36" FontWeight="Bold"/>
                  <TextBlock Text="事件处置率" Foreground="#8B949E" FontSize="12.5" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- 系统资源监控 -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel Margin="0,0,0,16">
                  <TextBlock Text="系统实时资源监控" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding SysUptimeText}" Foreground="#8B949E" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding NetText}" Foreground="#58A6FF" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Style="{StaticResource BtnSec}" Content="↺ 刷新" Command="{Binding RefreshResourceCommand}" Padding="10,6" FontSize="12"/>
                  </StackPanel>
                </DockPanel>
                <UniformGrid Columns="4">
                  <!-- CPU -->
                  <Border Style="{StaticResource SubCard}" Margin="0,0,8,0">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="CPU" Foreground="#8B949E" FontSize="12.5"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" Foreground="#58A6FF" FontSize="14" FontWeight="Bold"/>
                      </DockPanel>
                      <ProgressBar Style="{StaticResource PBar}" Value="{Binding CpuUsage}" Maximum="100"/>
                    </StackPanel>
                  </Border>
                  <!-- RAM -->
                  <Border Style="{StaticResource SubCard}" Margin="0,0,8,0">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="RAM" Foreground="#8B949E" FontSize="12.5"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MemText}" Foreground="#A98BFF" FontSize="14" FontWeight="Bold"/>
                      </DockPanel>
                      <ProgressBar Style="{StaticResource PBar}" Value="{Binding MemUsage}" Maximum="100"/>
                    </StackPanel>
                  </Border>
                  <!-- GPU -->
                  <Border Style="{StaticResource SubCard}" Margin="0,0,8,0">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="GPU" Foreground="#8B949E" FontSize="12.5"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding GpuText}" Foreground="#3FB950" FontSize="14" FontWeight="Bold"/>
                      </DockPanel>
                      <ProgressBar Style="{StaticResource PBar}" Value="{Binding GpuUsage}" Maximum="100"/>
                    </StackPanel>
                  </Border>
                  <!-- Disk -->
                  <Border Style="{StaticResource SubCard}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="磁盘" Foreground="#8B949E" FontSize="12.5"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DiskText}" Foreground="#F6C95F" FontSize="14" FontWeight="Bold"/>
                      </DockPanel>
                      <ProgressBar Style="{StaticResource PBar}" Value="{Binding DiskUsage}" Maximum="100"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <!-- 近 30 天趋势 -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="近 30 天风险事件趋势" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border CornerRadius="4" Padding="6,2" Background="#58A6FF22" Margin="0,0,8,0">
                      <TextBlock Text="● 全部事件" Foreground="#58A6FF" FontSize="12"/>
                    </Border>
                    <Border CornerRadius="4" Padding="6,2" Background="#F8514922">
                      <TextBlock Text="● 高风险事件" Foreground="#F85149" FontSize="12"/>
                    </Border>
                  </StackPanel>
                </DockPanel>
                <Border Background="#0D111788" CornerRadius="6" Height="170" Padding="0,5">
                  <Canvas Width="640" Height="160" HorizontalAlignment="Center">
                    <Polyline Points="{Binding TrendAllPoints}"  Stroke="#58A6FF" StrokeThickness="2"/>
                    <Polyline Points="{Binding TrendHighPoints}" Stroke="#F85149" StrokeThickness="2"/>
                  </Canvas>
                </Border>
                <DockPanel Margin="20,8,20,0">
                  <TextBlock Text="{Binding TrendLabel0}" Foreground="#444D56" FontSize="11"/>
                  <TextBlock Text="{Binding TrendLabel4}" Foreground="#444D56" FontSize="11" DockPanel.Dock="Right"/>
                  <TextBlock Text="{Binding TrendLabel2}" Foreground="#444D56" FontSize="11" HorizontalAlignment="Center"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- 模块统计 + 类型分布 -->
            <Grid Margin="0,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="340"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="各模块处理数据量" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
                  <ItemsControl ItemsSource="{Binding ModuleStats}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,12">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Foreground="#58A6FF"
                                     FontSize="13" FontWeight="Bold" Width="54" TextAlignment="Right" VerticalAlignment="Center"/>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="#8B949E" FontSize="12.5" Margin="0,0,0,5"/>
                            <Border CornerRadius="4" Height="8" Background="#30363D">
                              <Border CornerRadius="4" HorizontalAlignment="Left"
                                      Width="{Binding BarWidth}">
                                <Border.Background>
                                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#58A6FF" Offset="0"/>
                                    <GradientStop Color="#3FB950" Offset="1"/>
                                  </LinearGradientBrush>
                                </Border.Background>
                              </Border>
                            </Border>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- 事件类型饼图 + 处置甜甜圈 -->
              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="事件类型分布" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <DockPanel>
                      <Canvas Width="160" Height="160">
                        <Path Data="{Binding PieAigcPath}"     Fill="#F6C95F"/>
                        <Path Data="{Binding PieSemanticPath}" Fill="#58A6FF"/>
                        <Path Data="{Binding PieAuthPath}"     Fill="#A98BFF"/>
                        <Path Data="{Binding PieOtherPath}"    Fill="#8B949E"/>
                        <Ellipse Width="80" Height="80" Fill="#161B22" Canvas.Left="40" Canvas.Top="40"/>
                      </Canvas>
                      <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                          <Border Width="11" Height="11" Background="#F6C95F" CornerRadius="3" Margin="0,1,7,0"/>
                          <TextBlock Foreground="#E6EDF3" FontSize="12.5"><Run Text="AIGC  "/><Run Text="{Binding StatAigc}" FontWeight="Bold" Foreground="#F6C95F"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                          <Border Width="11" Height="11" Background="#58A6FF" CornerRadius="3" Margin="0,1,7,0"/>
                          <TextBlock Foreground="#E6EDF3" FontSize="12.5"><Run Text="语义  "/><Run Text="{Binding StatSemantic}" FontWeight="Bold" Foreground="#58A6FF"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                          <Border Width="11" Height="11" Background="#A98BFF" CornerRadius="3" Margin="0,1,7,0"/>
                          <TextBlock Foreground="#E6EDF3" FontSize="12.5"><Run Text="身份  "/><Run Text="{Binding StatAuth}" FontWeight="Bold" Foreground="#A98BFF"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <Border Width="11" Height="11" Background="#8B949E" CornerRadius="3" Margin="0,1,7,0"/>
                          <TextBlock Foreground="#E6EDF3" FontSize="12.5"><Run Text="其他  "/><Run Text="{Binding StatOther}" FontWeight="Bold" Foreground="#8B949E"/></TextBlock>
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="事件处置状态" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <DockPanel>
                      <Canvas Width="160" Height="160">
                        <Path Data="{Binding DonutResolvedPath}" Fill="#3FB950"/>
                        <Path Data="{Binding DonutIgnoredPath}"  Fill="#F6C95F"/>
                        <Path Data="{Binding DonutPendingPath}"  Fill="#F85149"/>
                        <Path Data="{Binding DonutFalsePosPath}" Fill="#8B949E"/>
                        <Ellipse Width="80" Height="80" Fill="#161B22" Canvas.Left="40" Canvas.Top="40"/>
                      </Canvas>
                      <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                          <Border Width="11" Height="11" Background="#3FB950" CornerRadius="3" Margin="0,1,7,0"/>
                          <TextBlock Foreground="#E6EDF3" FontSize="12.5"><Run Text="已处置  "/><Run Text="{Binding StatResolved}" FontWeight="Bold" Foreground="#3FB950"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                          <Border Width="11" Height="11" Background="#F6C95F" CornerRadius="3" Margin="0,1,7,0"/>
                          <TextBlock Foreground="#E6EDF3" FontSize="12.5"><Run Text="已忽略  "/><Run Text="{Binding StatIgnored}" FontWeight="Bold" Foreground="#F6C95F"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                          <Border Width="11" Height="11" Background="#F85149" CornerRadius="3" Margin="0,1,7,0"/>
                          <TextBlock Foreground="#E6EDF3" FontSize="12.5"><Run Text="待处置  "/><Run Text="{Binding StatPending}" FontWeight="Bold" Foreground="#F85149"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <Border Width="11" Height="11" Background="#8B949E" CornerRadius="3" Margin="0,1,7,0"/>
                          <TextBlock Foreground="#E6EDF3" FontSize="12.5"><Run Text="误报    "/><Run Text="{Binding StatFalsePos}" FontWeight="Bold" Foreground="#8B949E"/></TextBlock>
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <!-- 高风险会议 Top 5 -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="高风险会议 Top 5" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <DataGrid ItemsSource="{Binding TopRiskMeetings}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#"      Binding="{Binding Rank}"         Width="36"/>
                    <DataGridTextColumn Header="会议 ID" Binding="{Binding MeetingId}"    Width="*"/>
                    <DataGridTextColumn Header="主持人"  Binding="{Binding Host}"         Width="80"/>
                    <DataGridTextColumn Header="时间"    Binding="{Binding Time}"         Width="110"/>
                    <DataGridTextColumn Header="参会数"  Binding="{Binding Participants}" Width="60"/>
                    <DataGridTextColumn Header="事件数"  Binding="{Binding Events}"       Width="60"/>
                    <DataGridTextColumn Header="评分"    Binding="{Binding Score}"        Width="56"/>
                    <DataGridTextColumn Header="检测类型" Binding="{Binding Types}"       Width="100"/>
                    <DataGridTextColumn Header="状态"    Binding="{Binding Status}"       Width="70"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <!-- 审计日志 -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="操作审计日志" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <DataGrid ItemsSource="{Binding AuditLogs}" MaxHeight="240">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="时间"    Binding="{Binding Time}"     Width="130"/>
                    <DataGridTextColumn Header="操作员"  Binding="{Binding Operator}" Width="80"/>
                    <DataGridTextColumn Header="操作"    Binding="{Binding Action}"   Width="110"/>
                    <DataGridTextColumn Header="目标"    Binding="{Binding Target}"   Width="*"/>
                    <DataGridTextColumn Header="关联会议" Binding="{Binding Meeting}"  Width="150"/>
                    <DataGridTextColumn Header="结果"    Binding="{Binding Result}"   Width="56"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </Grid>
</Window>
