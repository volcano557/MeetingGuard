<Window x:Class="MeetingAgent.App.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetingAgent.App.Auth"
        Title="MeetingGuard · 登录"
        Width="900" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

  <Window.Resources>
    <!-- ── 颜色 ───────────────────────────── -->
    <SolidColorBrush x:Key="BgMain"      Color="#0D1117"/>
    <SolidColorBrush x:Key="BgCard"      Color="#161B22"/>
    <SolidColorBrush x:Key="BgInput"     Color="#21262D"/>
    <SolidColorBrush x:Key="BgSubCard"   Color="#21262D"/>
    <SolidColorBrush x:Key="BorderColor" Color="#30363D"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="TextMuted"   Color="#8B949E"/>
    <SolidColorBrush x:Key="AccentBlue"  Color="#58A6FF"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#3FB950"/>
    <SolidColorBrush x:Key="AccentRed"   Color="#F85149"/>

    <!-- ── 通用输入框样式 ─────────────────── -->
    <Style x:Key="InputBox" TargetType="TextBox">
      <Setter Property="Background"  Value="#21262D"/>
      <Setter Property="Foreground"  Value="#E6EDF3"/>
      <Setter Property="CaretBrush"  Value="#58A6FF"/>
      <Setter Property="SelectionBrush" Value="#58A6FF"/>
      <Setter Property="BorderBrush" Value="#30363D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontFamily" Value="Consolas, Courier New, Segoe UI"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    TextElement.Foreground="{TemplateBinding Foreground}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#58A6FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PwdBox" TargetType="PasswordBox">
      <Setter Property="Background"  Value="#21262D"/>
      <Setter Property="Foreground"  Value="#E6EDF3"/>
      <Setter Property="CaretBrush"  Value="#58A6FF"/>
      <Setter Property="BorderBrush" Value="#30363D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#58A6FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 按钮模板 ───────────────────────── -->
    <ControlTemplate x:Key="BtnTpl" TargetType="Button">
      <Border x:Name="bd" Background="{TemplateBinding Background}"
              CornerRadius="6" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background" Value="#1F6FEB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,12"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
    </Style>
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8B949E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
    </Style>

    <!-- ── Tab 头部按钮（登录 / 注册切换）──── -->
    <Style x:Key="TabBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8B949E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="0,0,0,0">
              <Grid>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border x:Name="underline" VerticalAlignment="Bottom" Height="2"
                        Background="#1F6FEB" Opacity="0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1A1F26"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- 整体阴影外框 -->
  <Border CornerRadius="12" Background="{StaticResource BgMain}"
          BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
    </Border.Effect>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ════════════════════════════════════════════════════
           左侧品牌墙（渐变背景 + Logo + 简介）
           ════════════════════════════════════════════════════ -->
      <Border Grid.Column="0" CornerRadius="12,0,0,12">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1F2A5C" Offset="0"/>
            <GradientStop Color="#0D1117" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <!-- 装饰圆 -->
          <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-110,-110,0" Opacity="0.13">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#58A6FF" Offset="0"/>
                <GradientStop Color="Transparent" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse Width="240" Height="240" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="-90,0,0,-90" Opacity="0.12">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#A98BFF" Offset="0"/>
                <GradientStop Color="Transparent" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <StackPanel Margin="36,52,36,36">
            <!-- 顶部 logo -->
            <DockPanel Margin="0,0,0,40">
              <Border Width="48" Height="48" CornerRadius="12"
                      Background="#1F6FEB" Margin="0,0,12,0">
                <TextBlock Text="🛡" FontSize="26" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MeetingGuard" Foreground="#E6EDF3" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="智能会议安全防护平台" Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>

            <TextBlock Text="多模态 AI 守护" Foreground="#E6EDF3" FontSize="26" FontWeight="Bold"
                       Margin="0,0,0,16" TextWrapping="Wrap"/>
            <TextBlock Foreground="#8B949E" FontSize="13" LineHeight="22" TextWrapping="Wrap">
              <Run Text="AIGC 视频检测  ·  人脸隐私保护"/>
              <LineBreak/>
              <Run Text="语义风险识别  ·  事件驱动采样"/>
            </TextBlock>

            <Border Margin="0,40,0,0" Padding="14,12" CornerRadius="8"
                    Background="#21262D88" BorderBrush="#30363D44" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="🔐 安全凭据" Foreground="#58A6FF" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Margin="0,6,0,0" Foreground="#8B949E" FontSize="11.5" TextWrapping="Wrap">
                  数据库采用 PBKDF2-HMAC-SHA256，逐用户随机盐 + 100 000 轮迭代加密。
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 版权 -->
          <TextBlock Text="© 2026 MeetingGuard Team"
                     Foreground="#444D56" FontSize="11"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="36,0,0,18"/>
        </Grid>
      </Border>

      <!-- ════════════════════════════════════════════════════
           右侧表单区
           ════════════════════════════════════════════════════ -->
      <Grid Grid.Column="1" Background="{StaticResource BgMain}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏（最小化 / 关闭） -->
        <DockPanel Grid.Row="0" Height="42" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Button x:Name="BtnClose" DockPanel.Dock="Right" Width="44" Height="42"
                  Background="Transparent" BorderThickness="0" Foreground="#8B949E"
                  FontSize="16" Cursor="Hand" Content="✕" Click="BtnClose_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#F85149"/>
                    <Setter Property="Foreground" Value="White"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button x:Name="BtnMinimize" DockPanel.Dock="Right" Width="44" Height="42"
                  Background="Transparent" BorderThickness="0" Foreground="#8B949E"
                  FontSize="18" Cursor="Hand" Content="–" Click="BtnMinimize_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#21262D"/>
                    <Setter Property="Foreground" Value="#E6EDF3"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBlock Text="" />
        </DockPanel>

        <!-- 表单容器 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="60,8,60,40">
            <!-- ─────── 登录视图 ─────── -->
            <StackPanel Visibility="{Binding IsRegisterMode, Converter={x:Static local:VisInverseConverter.Instance}}">
              <TextBlock Text="欢迎回来" Foreground="#E6EDF3" FontSize="26" FontWeight="Bold" Margin="0,0,0,8"/>
              <TextBlock Text="请使用账号密码登录会议安全防护平台" Foreground="#8B949E" FontSize="13" Margin="0,0,0,24"/>

              <!-- Tab 切换 -->
              <Border CornerRadius="8" BorderBrush="#30363D" BorderThickness="0,0,0,1" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource TabBtn}" Content="登 录"
                          Command="{Binding ShowLoginCommand}"
                          Foreground="#58A6FF">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border>
                          <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,11"/>
                            <Border VerticalAlignment="Bottom" Height="2" Background="#1F6FEB"/>
                          </Grid>
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                  <Button Style="{StaticResource TabBtn}" Content="注 册"
                          Command="{Binding ShowRegisterCommand}"
                          Padding="20,11"/>
                </StackPanel>
              </Border>

              <!-- 错误 / 成功提示 -->
              <Border Padding="12,10" CornerRadius="6" Margin="0,0,0,14"
                      Background="#F8514915" BorderBrush="#F8514944" BorderThickness="1"
                      Visibility="{Binding ErrorMessage, Converter={x:Static local:NotEmptyToVisConverter.Instance}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F85149" FontSize="12.5" TextWrapping="Wrap"/>
              </Border>
              <Border Padding="12,10" CornerRadius="6" Margin="0,0,0,14"
                      Background="#3FB95015" BorderBrush="#3FB95044" BorderThickness="1"
                      Visibility="{Binding SuccessMessage, Converter={x:Static local:NotEmptyToVisConverter.Instance}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#3FB950" FontSize="12.5" TextWrapping="Wrap"/>
              </Border>

              <!-- 用户名 -->
              <TextBlock Text="用户名" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
              <TextBox Style="{StaticResource InputBox}"
                       Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,0,0,14"/>

              <!-- 密码 -->
              <TextBlock Text="密码" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
              <PasswordBox x:Name="LoginPwdBox" Style="{StaticResource PwdBox}"
                           PasswordChanged="LoginPwdBox_Changed" Margin="0,0,0,14"/>

              <!-- 验证码 -->
              <TextBlock Text="图片验证码" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
              <Grid Margin="0,0,0,16" Height="40">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource InputBox}"
                         Text="{Binding LoginCaptchaInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="6" FontSize="18" FontWeight="SemiBold"/>
                <Border Grid.Column="2" CornerRadius="6" BorderBrush="#30363D" BorderThickness="1"
                        ClipToBounds="True" Cursor="Hand">
                  <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding RefreshCaptchaCommand}"/>
                  </Border.InputBindings>
                  <Grid>
                    <Image Source="{Binding CaptchaImage}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Padding="4,1"
                            Background="#000000A0">
                      <TextBlock Text="↻" Foreground="#E6EDF3" FontSize="10"/>
                    </Border>
                  </Grid>
                </Border>
              </Grid>

              <!-- 记住密码 + 忘记 -->
              <DockPanel Margin="0,0,0,18">
                <CheckBox IsChecked="{Binding RememberMe}" Foreground="#8B949E" FontSize="12"
                          Content="记住用户名" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostBtn}"
                        Content="忘记密码？" Foreground="#58A6FF"
                        Command="{Binding ForgetPasswordCommand}"/>
              </DockPanel>

              <Button Style="{StaticResource PrimaryBtn}"
                      Content="登 录"
                      Command="{Binding DoLoginCommand}"
                      IsDefault="True" Margin="0,0,0,18"/>

              <Border Padding="12,10" CornerRadius="6" Background="#21262D" Margin="0,0,0,0">
                <TextBlock Foreground="#8B949E" FontSize="11.5" TextWrapping="Wrap">
                  <Run Text="💡 测试账户："/>
                  <Run Foreground="#58A6FF" Text="admin / admin123"/>
                  <Run Text="  或  "/>
                  <Run Foreground="#58A6FF" Text="demo / demo123"/>
                </TextBlock>
              </Border>
            </StackPanel>

            <!-- ─────── 注册视图 ─────── -->
            <StackPanel Visibility="{Binding IsRegisterMode, Converter={x:Static local:BoolToVisConverter.Instance}}">
              <TextBlock Text="创建账户" Foreground="#E6EDF3" FontSize="26" FontWeight="Bold" Margin="0,0,0,8"/>
              <TextBlock Text="注册新用户以使用 MeetingGuard 安全防护功能" Foreground="#8B949E" FontSize="13" Margin="0,0,0,24"/>

              <!-- Tab 切换 -->
              <Border BorderBrush="#30363D" BorderThickness="0,0,0,1" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource TabBtn}" Content="登 录"
                          Command="{Binding ShowLoginCommand}"
                          Padding="20,11"/>
                  <Button Style="{StaticResource TabBtn}" Content="注 册"
                          Command="{Binding ShowRegisterCommand}"
                          Foreground="#58A6FF">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border>
                          <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,11"/>
                            <Border VerticalAlignment="Bottom" Height="2" Background="#1F6FEB"/>
                          </Grid>
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </StackPanel>
              </Border>

              <!-- 错误 / 成功提示 -->
              <Border Padding="12,10" CornerRadius="6" Margin="0,0,0,14"
                      Background="#F8514915" BorderBrush="#F8514944" BorderThickness="1"
                      Visibility="{Binding ErrorMessage, Converter={x:Static local:NotEmptyToVisConverter.Instance}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F85149" FontSize="12.5" TextWrapping="Wrap"/>
              </Border>

              <!-- 用户名 -->
              <TextBlock Text="用户名" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
              <TextBox Style="{StaticResource InputBox}"
                       Text="{Binding RegUsername, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,0,0,12"/>

              <!-- 密码 + 确认密码 -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="密码（≥ 6 位）" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
                  <PasswordBox x:Name="RegPwdBox" Style="{StaticResource PwdBox}"
                               PasswordChanged="RegPwdBox_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="确认密码" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
                  <PasswordBox x:Name="RegPwd2Box" Style="{StaticResource PwdBox}"
                               PasswordChanged="RegPwd2Box_Changed"/>
                </StackPanel>
              </Grid>

              <!-- 邮箱 + 角色 -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="邮箱（用于密码找回）" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
                  <TextBox Style="{StaticResource InputBox}"
                           Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="角色" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
                  <ComboBox ItemsSource="{Binding RoleOptions}"
                            SelectedItem="{Binding RegRole, Mode=TwoWay}"/>
                </StackPanel>
              </Grid>

              <!-- 验证码 -->
              <TextBlock Text="图片验证码" Foreground="#8B949E" FontSize="12" Margin="0,0,0,6"/>
              <Grid Margin="0,0,0,18" Height="40">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource InputBox}"
                         Text="{Binding RegCaptchaInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="6" FontSize="18" FontWeight="SemiBold"/>
                <Border Grid.Column="2" CornerRadius="6" BorderBrush="#30363D" BorderThickness="1"
                        ClipToBounds="True" Cursor="Hand">
                  <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding RefreshCaptchaCommand}"/>
                  </Border.InputBindings>
                  <Grid>
                    <Image Source="{Binding CaptchaImage}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Padding="4,1"
                            Background="#000000A0">
                      <TextBlock Text="↻" Foreground="#E6EDF3" FontSize="10"/>
                    </Border>
                  </Grid>
                </Border>
              </Grid>

              <Button Style="{StaticResource PrimaryBtn}"
                      Content="注 册"
                      Command="{Binding DoRegisterCommand}"
                      IsDefault="True" Margin="0,0,0,16"/>

              <Border Padding="12,10" CornerRadius="6" Background="#21262D">
                <TextBlock Foreground="#8B949E" FontSize="11.5" TextWrapping="Wrap">
                  <Run Text="🔒 密码安全说明："/>
                  <LineBreak/>
                  <Run Text="数据库以 PBKDF2-HMAC-SHA256 算法加密存储，"/>
                  <Run Text="逐用户独立随机盐 16 字节 + 100 000 轮迭代，"/>
                  <Run Text="即使数据库泄露也无法还原原始密码。"/>
                </TextBlock>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
